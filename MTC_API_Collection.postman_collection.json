{
	"info": {
		"_postman_id": "mtc-backend-api-collection-2026",
		"name": "MTC Backend API Collection (Official)",
		"description": "Bộ API hoàn chỉnh của Hệ thống Quản trị & Điều hành Màn hình / Loa Tập trung (MTC Backend .NET 8). Đã cấu hình sẵn biến {{baseUrl}}, tự động lưu {{token}} sau khi Đăng nhập.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Authentication & 2FA",
			"item": [
				{
					"name": "1. Đăng nhập (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    if (jsonData.data.accessToken) {",
									"        pm.collectionVariables.set(\"token\", jsonData.data.accessToken);",
									"        console.log(\"Saved accessToken into collection variable.\");",
									"    }",
									"    if (jsonData.data.refreshToken) {",
									"        pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);",
									"        console.log(\"Saved refreshToken into collection variable.\");",
									"    }",
									"    if (jsonData.data.user && jsonData.data.user.userId) {",
									"        pm.collectionVariables.set(\"userId\", jsonData.data.user.userId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123456\",\n  \"rememberMe\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "2. Xác thực 2 bước (Verify 2FA)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set(\"token\", jsonData.data.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": \"{{userId}}\",\n  \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/verify-2fa",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"verify-2fa"
							]
						}
					}
				},
				{
					"name": "3. Làm mới Token (Refresh Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set(\"token\", jsonData.data.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"accessToken\": \"{{token}}\",\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/refresh-token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"refresh-token"
							]
						}
					}
				},
